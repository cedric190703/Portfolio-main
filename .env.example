# Copy to .env.local. Never use a NEXT_PUBLIC_ prefix for credentials.
# Leave empty to use predefined Q&A without contacting a model provider.
OPENROUTER_API_KEY=
# Locked to openrouter/free. Any other value disables AI; no paid fallback.
OPENROUTER_MODEL=openrouter/free
# Hard maximum: 40 site-wide/day and 5 per visitor/day; settings can only lower these.
CHAT_DAILY_LIMIT=40
CHAT_VISITOR_DAILY_LIMIT=5

# Required for production inference; not needed for next dev locally.
# Redis REST API compatible with Upstash; store only quota counters, not chats.
CHAT_REDIS_REST_URL=
CHAT_REDIS_REST_TOKEN=
# A random secret of at least 32 characters, shared across server instances.
CHAT_COOKIE_SECRET=
# Optional canonical origin, e.g. https://your-portfolio.example
CHAT_ALLOWED_ORIGIN=
